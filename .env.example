# Leaderboard storage (required for /api/leaderboard)
# Create a free Redis database: https://console.upstash.com
# Then in Vercel: Project -> Settings -> Environment Variables
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# If you use Vercel KV instead, these names also work:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
